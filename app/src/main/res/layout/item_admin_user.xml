<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/card_bg"
    android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Name"/>
    <TextView android:id="@+id/tvEmail" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_muted" android:textSize="12sp" android:text="Email"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/tvUsername" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/lime" android:textSize="11sp" android:text="@username"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  •  " android:textColor="@color/text_muted" android:textSize="11sp"/>
        <TextView android:id="@+id/tvRole" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_muted" android:textSize="11sp" android:text="Role"/>
    </LinearLayout>
    <TextView android:id="@+id/tvVerified" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:layout_marginTop="3dp" android:text="Pending"/>
    <TextView android:id="@+id/tvCreated" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/text_muted" android:textSize="10sp" android:text="Joined"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/btnApprove" android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:layout_marginEnd="6dp"
            android:backgroundTint="@color/lime" android:text="Approve" android:textColor="@color/green_deep" android:textSize="12sp"/>
        <Button android:id="@+id/btnReject" android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:backgroundTint="#FF5252" android:text="Reject" android:textColor="@color/white" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>