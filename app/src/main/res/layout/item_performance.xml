<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/card_bg"
    android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvStudent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Student"/>
        <TextView android:id="@+id/tvProgram" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/lime" android:textSize="12sp" android:layout_marginTop="3dp" android:text="Program"/>
        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_muted" android:textSize="11sp" android:text="Date"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="12sp" android:text="Score: --"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="   Grade: " android:textColor="@color/text_muted" android:textSize="12sp"/>
            <TextView android:id="@+id/tvGrade" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/lime" android:textSize="12sp" android:textStyle="bold" android:text="A"/>
        </LinearLayout>
        <TextView android:id="@+id/tvComments" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_muted" android:textSize="11sp" android:text=""/>
    </LinearLayout>
    <ImageButton android:id="@+id/btnDelete" android:layout_width="36dp" android:layout_height="36dp"
        android:background="@drawable/circle_button_bg" android:src="@android:drawable/ic_menu_delete" android:tint="#FF5252"/>
</LinearLayout>